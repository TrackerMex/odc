{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "./init.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/env-guard.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking .env guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/backend-lint.mjs\"",
            "timeout": 30,
            "statusMessage": "Linting backend file"
          }
        ]
      }
    ]
  }
}
